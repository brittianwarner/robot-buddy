{
  "name": "robot-buddy",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:pedantic": "turbo run lint:pedantic",
    "format": "cargo fmt --all",
    "format:check": "turbo run format:check",
    "test:integration": "bun tests/integration.mjs",
    "bench:e2e": "bun tests/bench-e2e.mjs",
    "test:container": "cargo test -p robot-buddy-server --test container -- --ignored",
    "test:lab": "bun tests/lab.mjs",
    "dev:lab": "docker compose -f compose.local.yaml up --build -d",
    "dev:lab:stop": "docker compose -f compose.local.yaml down"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "turbo": "2.8.20"
  }
}
