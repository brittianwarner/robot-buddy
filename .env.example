# Generate values with: robot-buddy-server init secrets
BUDDY_SIGNING_KEY=
RIVET_TOKEN=
DEVICE_ISSUER_PUBLIC_KEY=
# Browser and robot reachable HTTPS URLs, normally behind your existing TLS proxy.
BUDDY_PUBLIC_URL=https://buddy.example.com
BUDDY_PUBLIC_RIVET_URL=https://rivet.buddy.example.com
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=
BRAVE_SEARCH_API_KEY=
# OIDC provider for browser sign-in. Register BUDDY_PUBLIC_URL/auth/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional external object storage: switch to s3 and provide these fields.
BUDDY_STORAGE_BACKEND=file_system
# BUDDY_S3_BUCKET=
# BUDDY_S3_REGION=us-east-1
# BUDDY_S3_ENDPOINT=https://s3.example.com
# BUDDY_S3_ACCESS_KEY_ID=
# BUDDY_S3_SECRET_ACCESS_KEY=
# Optional operator test UI at /lab. Disabled when empty. Generate 32+ random bytes.
BUDDY_LAB_TOKEN=
# Fail-fast process-wide inference capacity (1..256).
AI_MAX_CONCURRENT=16

# Optional OpenRouter reasoning effort; must be supported by your selected model.
AI_REASONING_EFFORT=
# For GLM Flash + Nitro: AI_MODEL=z-ai/glm-5.3-flash:nitro and AI_REASONING_EFFORT=low

# Optional speech; uses OpenRouter AI_API_KEY unless TTS_API_KEY is set.
# The PCM adapter accepts only elevenlabs/eleven-v4-turbo.
TTS_MODEL=
# TTS_API_KEY=
# Robot playback: BUDDY_SPEECH=true (requires ALSA aplay on Linux).
