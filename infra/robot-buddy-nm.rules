// /etc/polkit-1/rules.d/50-robot-buddy-nm.rules
//
// Lets the robot-buddy service account manage its two NetworkManager
// profiles without root: add and delete system profiles (and save the home
// Wi-Fi password NetworkManager receives during activation), activate them,
// and share a connection for the setup hotspot. Nothing else is granted.
//
// polkit cannot see which profile a call names, so these actions cover every
// profile. The account has no login shell and no other privileges.
polkit.addRule(function (action, subject) {
  if (subject.user !== "robot-buddy") {
    return polkit.Result.NOT_HANDLED;
  }
  switch (action.id) {
    case "org.freedesktop.NetworkManager.settings.modify.system":
    case "org.freedesktop.NetworkManager.network-control":
    case "org.freedesktop.NetworkManager.wifi.share.protected":
    case "org.freedesktop.NetworkManager.wifi.share.open":
    case "org.freedesktop.NetworkManager.enable-disable-wifi":
      return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
