# /etc/robot-buddy/device.env, read by systemd (root, mode 0600). Every
# variable is documented in docs/architecture/robot-client.md.

BUDDY_SERVER_URL=https://buddy.example.com
# Device credentials from `robot-buddy-server provision` (mode 0640,
# root:robot-buddy). Never commit or share this file.
BUDDY_IDENTITY_FILE=/etc/robot-buddy/device.identity.json

# Speak replies through the MAX98357A I2S amplifier. Name the ALSA device
# explicitly: on Raspberry Pi OS with a desktop, the ALSA default routes to a
# per-user PipeWire that the service account does not have. `aplay -L` lists
# names; `plughw:` converts the 24 kHz mono stream to what the amp accepts. The
# card name depends on the overlay (dtoverlay=max98357a, or hifiberry-dac, which
# shows as sndrpihifiberry).
BUDDY_SPEECH=true
#BUDDY_ALSA_DEVICE=plughw:CARD=MAX98357A,DEV=0
#BUDDY_ALSA_BUFFER_US=120000

# ESP32-S3 face. Use the stable by-id path (`ls /dev/serial/by-id/`), not
# /dev/ttyACM0, which can change when the board re-enumerates. The client sets
# the line to raw 115200 itself on every open.
#BUDDY_FACE_SERIAL=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_XX:XX:XX:XX:XX:XX-if00

#BUDDY_WIFI_INTERFACE=wlan0
#BUDDY_WIFI_GRACE_SECS=300

# Loopback owner-confirmation panel. Unset: 127.0.0.1:8090. `off` disables it
# on a headless robot. Only loopback addresses are accepted.
#BUDDY_SCREEN_ADDR=127.0.0.1:8090

# BUDDY_CONTROL_SOCKET is set by the unit (/run/robot-buddy/control.sock).
