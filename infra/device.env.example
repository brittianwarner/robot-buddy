# /etc/robot-buddy/device.env, read by systemd (root, mode 0600). Every
# hardware option and the installation sequence are documented in DEPLOYMENT.md.

BUDDY_SERVER_URL=https://buddy.example.com
# Device credentials from `robot-buddy-server provision` (mode 0600, owned by
# robot-buddy). Never commit or share this file.
BUDDY_IDENTITY_FILE=/etc/robot-buddy/device.identity.json

# Speak replies through the MAX98357A I2S amplifier. Name the ALSA device
# explicitly: on Raspberry Pi OS with a desktop, the ALSA default routes to a
# per-user PipeWire that the service account does not have. `aplay -L` lists
# names; `plughw:` converts the 24 kHz mono stream to what the amp accepts. The
# card name depends on the overlay (dtoverlay=max98357a, or hifiberry-dac, which
# shows as sndrpihifiberry).
BUDDY_SPEECH=true
#BUDDY_ALSA_DEVICE=plughw:CARD=MAX98357A,DEV=0
#BUDDY_ALSA_BUFFER_US=120000

# ESP32-S3 face. Use the stable by-id path (`ls /dev/serial/by-id/`), not
# /dev/ttyACM0, which can change when the board re-enumerates. The client sets
# the line to raw 115200 itself on every open.
#BUDDY_FACE_SERIAL=/dev/serial/by-id/usb-Espressif_USB_JTAG_serial_debug_unit_XX:XX:XX:XX:XX:XX-if00

#BUDDY_WIFI_INTERFACE=wlan0
#BUDDY_WIFI_GRACE_SECS=300
# Setup hotspot name and password, created once (0600). Unset: setup-wifi.json in
# the unit's state directory (/var/lib/robot-buddy). Print the card with
# `runuser -u robot-buddy -- robot-buddy-robot setup-card`.
#BUDDY_SETUP_WIFI_FILE=/var/lib/robot-buddy/setup-wifi.json

# Loopback owner-confirmation panel. Unset: 127.0.0.1:8090. `off` disables it
# on a headless robot. Only loopback addresses are accepted.
#BUDDY_SCREEN_ADDR=127.0.0.1:8090

# BUDDY_CONTROL_SOCKET is set by the unit (/run/robot-buddy/control.sock). The
# socket's group is BUDDY_CONTROL_GROUP (default pip-control); if that group is
# missing the socket keeps the service's own group.
#BUDDY_CONTROL_GROUP=pip-control

# Full Pip profile: enable only installed peripherals. Take the reSpeaker card
# name from `arecord -L`. The values below are for the spec's reSpeaker Flex
# XVF3800: 2 interleaved channels, channel 0 the processed beam, channel 1 the ASR
# beam. Unset, the client captures 1 channel from ALSA `default`.
#BUDDY_LISTEN_MODEL=/opt/robot-buddy/models/ggml-tiny.en.bin
#BUDDY_LISTEN_WHISPER=/usr/local/bin/whisper-cli
#BUDDY_LISTEN_DEVICE=plughw:CARD=REPLACE_WITH_MIC_CARD,DEV=0
#BUDDY_LISTEN_CHANNELS=2
#BUDDY_LISTEN_CHANNEL=0
#BUDDY_LISTEN_BARGE_IN=0
# For the onnx-wake build, this directory contains the three approved ONNX files.
#BUDDY_LISTEN_WAKE_DIR=/opt/robot-buddy/models/wake
#ORT_DYLIB_PATH=/opt/onnxruntime/lib/libonnxruntime.so

# Use a DIFFERENT USB by-id path from the face board. Provision and verify
# all three EEPROM limits using this robot's measured calibration before enabling.
#BUDDY_SERVO_PORT=/dev/serial/by-id/REPLACE_WITH_NECK_ADAPTER
#BUDDY_SERVO_CALIBRATION=/etc/robot-buddy/neck.json

# pi-vision build: SFace and a local gallery enable recognition, not authentication.
#BUDDY_VISION=1
#BUDDY_VISION_YUNET=/opt/robot-buddy/models/face_detection_yunet_2023mar.onnx
#BUDDY_VISION_SFACE=/opt/robot-buddy/models/face_recognition_sface_2021dec.onnx
#BUDDY_VISION_GALLERY=/var/lib/robot-buddy/faces
# Set to 1 if the preview is upside down. The tuning file is optional and must be
# a regular file, for example a libcamera NoIR tuning JSON.
#BUDDY_VISION_ROTATE_180=1
#BUDDY_VISION_TUNING_FILE=/usr/share/libcamera/ipa/rpi/pisp/REPLACE_WITH_TUNING.json

# Optional local console (SSH tunnel). Generate BUDDY_OPERATOR_TOKEN separately.
#BUDDY_OPERATOR_ADDR=127.0.0.1:8091
# Optional offline announcement. Keep the Piper binary and voice separate.
#BUDDY_PIPER_BIN=/usr/local/bin/piper
#BUDDY_PIPER_MODEL=/opt/robot-buddy/models/voice.onnx
