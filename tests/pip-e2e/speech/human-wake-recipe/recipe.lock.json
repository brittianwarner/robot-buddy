  "description": "Reproducible provenance recipe for prerecorded human speech wake positives and ablation controls. No audio media or private ONNX models are stored in git; prepare.py downloads upstream audio into gitignored tests/pip-e2e/.cache/speech/human-wake-positive/, verifies SHA-256 digests, and produces deterministic 16kHz mono S16_LE WAV/PCM clips.",
  "policy": {
    "no_media_or_models_in_git": true,
    "private_classifier_opt_in_env": "PIP_E2E_HEY_PIP_ONNX (explicit operator-owned read-only path; no default)",
    "superseded_by_operator_recording": "A verified, consented natural recording of 'Hey Pip' from Brittian supersedes the edited/spliced component-level clips for all acceptance testing.",
    "strict_provenance_distinction": {
      "human_recorded_natural": "Unedited contiguous slice from a public-domain human recording. Valid natural speech evidence for Whisper transcript wake; does NOT fire hey_pip.onnx (bare 'Pip, ...', not 'Hey Pip').",
      "edited_spliced_human": "Component-level test stimulus assembled by trimming dead air and concatenating real licensed human word recordings. Explicitly NOT a natural held-out recording; must NEVER be represented as natural human recall/FAR evidence."
    }
  },
